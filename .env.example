# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: Project Settings > Database > Connection string (transaction pooler)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
# Supabase: Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Anthropic Console > API Keys
ANTHROPIC_API_KEY=

# PayPal Developer Dashboard > Apps & Credentials (Sandbox), US sandbox business account
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PayPal app > Webhooks: the id of the webhook pointing at /api/webhooks/paypal
PAYPAL_WEBHOOK_ID=
